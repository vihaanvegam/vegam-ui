# Normalise line endings. The repo is authored on Windows and CI runs Linux;
# Prettier is configured for LF, so without this a contributor with
# core.autocrlf=true gets CRLF working files and `pnpm format:check` fails.
* text=auto eol=lf

# Generated by `pnpm graph`. These ARE committed — `pnpm graph:check` diffs them
# against freshly generated output, so gitignoring them would break CI. Marking
# them generated collapses them in pull-request diffs and keeps them out of
# GitHub's language statistics.
docs/ARCHITECTURE.md linguist-generated=true
docs/graphify.html linguist-generated=true

# Lockfile: committed and security-relevant, but not worth reading as a diff.
pnpm-lock.yaml linguist-generated=true

# Changelogs are generated by Changesets but are the human-facing release
# history — leave them fully visible in diffs.
