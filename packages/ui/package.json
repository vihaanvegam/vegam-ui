{
  "name": "@vegam-ui/ui",
  "version": "0.1.0",
  "description": "vegam-ui React component library. Framework-agnostic packaging: ESM + CJS, dual type declarations, one CSS file.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vihaanvegam/vegam-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/vihaanvegam/vegam-ui#readme",
  "bugs": "https://github.com/vihaanvegam/vegam-ui/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vegam-ui/tokens": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup-preserve-directives": "^1.1.3",
    "storybook": "^10.5.5",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
