{
  "name": "@vegam-ui/tokens",
  "version": "0.1.0",
  "description": "Design tokens for vegam-ui: CSS custom properties, SCSS variables, and JS constants generated from a single tokens.json.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/tokens.cjs",
  "module": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/tokens.d.ts",
        "require": "./dist/tokens.d.cts"
      },
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.scss": "./dist/tokens.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.js"
  },
  "devDependencies": {
    "style-dictionary": "^4.4.0"
  }
}
