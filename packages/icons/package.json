{
  "name": "@vegam-ui/icons",
  "version": "0.1.0",
  "description": "vegam-ui icon set: one tree-shakeable React component per icon, currentColor-driven, server-component safe.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vihaanvegam/vegam-ui.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/vihaanvegam/vegam-ui#readme",
  "bugs": "https://github.com/vihaanvegam/vegam-ui/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/build-icons.mjs",
    "icons:check": "node scripts/build-icons.mjs --check",
    "icons:import": "node scripts/import-figma-svgs.mjs"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
